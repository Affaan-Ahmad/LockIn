# ---------------------------------------------------------------------------
# Public (safe to expose to the browser). Nothing secret may ever live here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local development. In production this must be the real origin --
# https://lockinapp.tech -- because it builds the Google OAuth redirect, and a
# mismatch against the URI registered in the Google console fails the sign-in
# with redirect_uri_mismatch. Set it in the host's environment, not here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only. These must never be prefixed NEXT_PUBLIC_ and never be logged.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# 32 raw bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored Google refresh token: users reconnect.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional. Enables the daily recovery sweep at GET /api/sync/sweep, which picks
# up runs no continuation came back for. At least 16 characters; generate it the
# same way as the key above. Vercel sends it as `Authorization: Bearer <value>`
# on cron invocations.
#
# Unset, the sweep endpoint refuses every request rather than standing open, and
# the system is still correct without it -- the sweep is a floor, not the
# mechanism. Set it in the host's environment, never here.
#
# Left commented out on purpose: an empty value is *present* and fails the
# minimum length, which is a worse outcome than omitting it entirely.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Tunables (all optional; defaults are the values shown, from src/config/env.ts)
# ---------------------------------------------------------------------------
SYNC_COURSE_CONCURRENCY=4
# How long a lease survives without a heartbeat -- not how long a sync takes.
# The worker renews it every third of this interval, so this is really "how long
# after a worker dies before somebody may take over". Short is good: it bounds
# the recovery delay. A run the platform kills is resumable once this lapses.
SYNC_LEASE_TTL_SECONDS=90
# Seed estimate for one course, and the ceiling on retrying one. The worker
# replaces the seed with the worst duration it actually observes.
SYNC_UNIT_ESTIMATE_MS=12000
SYNC_MAX_COURSE_ATTEMPTS=3
GOOGLE_MAX_RETRY_ATTEMPTS=3
# Timeout x (retries + 1) is one call's worst case -- 40s at these defaults.
# A production build refuses to start if that worst case exceeds four times
# SYNC_UNIT_ESTIMATE_MS, so one stalled call cannot dwarf the budget for a whole
# course. It is a ceiling on the ratio, not a claim that a single call fits
# inside one course's estimate; at these defaults it does not.
GOOGLE_REQUEST_TIMEOUT_MS=10000
# Rate limits on the two operations that reach Google.
SYNC_RATE_LIMIT=10
SYNC_RATE_WINDOW_SECONDS=600
DISCOVERY_RATE_LIMIT=20
DISCOVERY_RATE_WINDOW_SECONDS=600

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Class timetable (optional). Unset, the timetable screens report the feature as
# unconfigured and the rest of the application is unaffected.
# ---------------------------------------------------------------------------
# The published timetable document. The university issues a new one each
# semester, which is why this is configuration and not a constant.
# TIMETABLE_SPREADSHEET_ID=

# A credential for an account that can already open that document -- read via
# the Sheets API as a member of the university's domain, so it keeps working if
# the document stops being link-viewable.
#
# These belong to their own Google Cloud project, deliberately separate from the
# Classroom client above: the OAuth consent screen is per-project, and the
# student-facing app must keep asking for its four read-only Classroom scopes
# and nothing else.
#
# Obtain the refresh token by running the one-time consent script and approving
# as the university account. Never commit any of these.
# TIMETABLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# TIMETABLE_OAUTH_CLIENT_SECRET=
# TIMETABLE_REFRESH_TOKEN=
